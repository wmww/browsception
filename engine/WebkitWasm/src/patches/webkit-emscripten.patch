+/*
+ * PORT=Emscripten GL/compositing link stubs.
+ *
+ * This port has NO GPU path: the engine's wasm module must import no GL,
+ * WebGL or EGL entry point at all (notes/security.md — "an owned engine
+ * cannot reach the GPU driver" is a property of the import list, not an
+ * argument about reachability). So PlatformDisplay is never created, no GL
+ * context ever exists, and Skia paints CPU raster only.
+ *
+ * What remains here is referenced-but-never-run code: wasm static linking
+ * has no lazy binding, so every referenced symbol must resolve. Each stub
+ * fails in the way its callers already handle (null context / no display),
+ * which is exactly the state they saw before, when GPU mode was merely
+ * never switched on.
+ */
+
+#include "config.h"
+#include "GLContext.h"
+#include "GLFence.h"
+#include "GraphicsLayer.h"
