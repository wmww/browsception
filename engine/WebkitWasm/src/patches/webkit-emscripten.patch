diff --git a/Source/cmake/OptionsEmscripten.cmake b/Source/cmake/OptionsEmscripten.cmake
new file mode 100644
index 00000000000..a967c1e843b
--- /dev/null
+++ b/Source/cmake/OptionsEmscripten.cmake
@@ -0,0 +1,168 @@
+# PORT=Emscripten: WebCore + JavaScriptCore compiled to WebAssembly with
+# Emscripten. Single-process WebKit1-style embedder; no WebKit2, no tools.
+#
+# Modeled on OptionsJSCOnly.cmake (proven by the Phase 1 wasm JSCOnly build),
+# with the WebCore dependency surface borrowed from OptionsWin.cmake and
+# OptionsPlayStation.cmake (curl networking, Skia CPU raster).
+
+find_package(Threads REQUIRED)
+
+set(CMAKE_C_VISIBILITY_PRESET hidden)
+set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+
+add_definitions(-DBUILDING_EMSCRIPTEN__)
+
+set(PROJECT_VERSION_MAJOR 1)
+set(PROJECT_VERSION_MINOR 0)
+set(PROJECT_VERSION_MICRO 0)
+set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_MICRO})
+
+# Single-process embedder: WebCore is the top of our stack. No WebKit2
+# (multiprocess/IPC), no legacy API layer, no inspector UI, no Tools
+# (MiniBrowser, TestWebKitAPI, DumpRenderTree).
+set(ENABLE_WEBKIT OFF)
+set(ENABLE_WEBKIT_LEGACY OFF)
+set(ENABLE_WEBINSPECTORUI OFF)
+set(ENABLE_TOOLS OFF)
+set(ENABLE_WEBGPU OFF)
+
+WEBKIT_OPTION_BEGIN()
+
+WEBKIT_OPTION_DEFINE(ENABLE_STATIC_JSC "Whether to build JavaScriptCore as a static library." PUBLIC ON)
+
+# JavaScriptCore: CLoop interpreter only — wasm cannot self-JIT.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTL_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DFG_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY PRIVATE OFF)
+
+# HARD CONSTRAINT: Thread::suspend() traps under wasm — never enable.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SAMPLING_PROFILER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_REMOTE_INSPECTOR PRIVATE OFF)
+
+# Allocator: emmalloc/dlmalloc via USE_SYSTEM_MALLOC. bmalloc's virtual
+# memory reservation tricks do not fit wasm32 linear memory.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC PRIVATE ON)
+
+# Graphics: Skia CPU raster (vendored Source/ThirdParty/skia) into a plain
+# memory buffer; the embedder blits pixels to the host <canvas>. cairo is
+# dead in WebKit >= 2.46. The GPU path (Skia -> WebGL2) is a later phase.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA_ENCODERS PRIVATE OFF)
+
+# Optional web features: everything OFF for first bring-up. (FTPDIR also has
+# no transport that could serve it — see the networking note below.)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTPDIR PRIVATE OFF)
+# Tier A2 (task #62): VIDEO on with ZERO media engines registered — no
+# USE(GSTREAMER)/AVFOUNDATION, so MediaPlayer falls back to its null
+# private. <video>/<audio> become real DOM elements with spec-correct
+# error events (MEDIA_ERR_SRC_NOT_SUPPORTED) and canPlayType() == "";
+# actual playback is a later host-bridge epic. Replaces the A1 JS stub
+# (web/media-stub.js self-disables when the real bindings exist).
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUDIO PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGL PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SOURCE PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STREAM PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_RTC PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ENCRYPTED_MEDIA PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GAMEPAD PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPEECH_SYNTHESIS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_NOTIFICATIONS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GEOLOCATION PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FULLSCREEN_API PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBXR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_XSLT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MATHML PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBDRIVER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MINIBROWSER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_API_TESTS PRIVATE OFF)
+
+# Image formats beyond the sysroot tier (jpeg/png/webp) stay off.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_AVIF PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_JPEGXL PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_LCMS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2 PRIVATE OFF)
+
+WEBKIT_OPTION_END()
+
+# wasm builds are fully static; a SHARED JavaScriptCore is not supported.
+if (NOT ENABLE_STATIC_JSC)
+    message(FATAL_ERROR "PORT=Emscripten requires ENABLE_STATIC_JSC=ON (wasm builds are fully static)")
+endif ()
+
+# Event loop: generic RunLoop (RunLoopGeneric.cpp). Emscripten has no GLib.
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+
+# Platform options (PlayStation idiom): socket-backed remote inspector when
+# enabled (OFF by default here), unix-domain-socket SharedMemory handles —
+# platform/unix/SharedMemoryUnix.cpp is gated on USE(UNIX_DOMAIN_SOCKETS).
+SET_AND_EXPOSE_TO_BUILD(USE_INSPECTOR_SOCKET_SERVER ${ENABLE_REMOTE_INSPECTOR})
+SET_AND_EXPOSE_TO_BUILD(USE_UNIX_DOMAIN_SOCKETS ON)
+
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+
+if (ENABLE_WEBCORE)
+    # Networking: no transport in the engine — loads go out over the
+    # embedder's host-fetch bridge. USE_CURL still selects the curl port's
+    # platform TYPES (ResourceRequest/Response/Error, CertificateInfo,
+    # ProtectionSpace, AuthenticationChallenge) and the CookieJarDB cookie
+    # jar; libcurl itself is not linked. See WebCore/PlatformEmscripten.cmake.
+    # USE_OPENSSL selects PAL's CryptoDigestOpenSSL (libcrypto only).
+    SET_AND_EXPOSE_TO_BUILD(USE_CURL ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_OPENSSL ON)
+
+    if (USE_SKIA)
+        find_package(HarfBuzz 1.4.2 REQUIRED COMPONENTS ICU)
+        SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ ON)
+    endif ()
+
+    # Provided by third_party/wasm-sysroot (found via CMAKE_FIND_ROOT_PATH).
+    find_package(Freetype 2.9.0 REQUIRED)
+
+    # Web fonts (GTK idiom): the sysroot FreeType is built with brotli
+    # (FT_CONFIG_OPTION_USE_BROTLI), so it decodes WOFF2 natively — no
+    # libwoff2 needed (USE_WOFF2 stays OFF). HAVE_WOFF_SUPPORT gates
+    # FontCustomPlatformData's format acceptance; without it every
+    # woff/woff2 @font-face (i.e. all modern web fonts, all icon fonts)
+    # was silently rejected and text fell back to DejaVu.
+    include(WOFF2Checks)
+    if (FREETYPE_WOFF2_SUPPORT_IS_AVAILABLE)
+        SET_AND_EXPOSE_TO_BUILD(HAVE_WOFF_SUPPORT ON)
+    else ()
+        message(FATAL_ERROR "Sysroot FreeType lacks brotli/WOFF2 — rerun tools/build-deps/webcore-deps.sh (freetype section)")
+    endif ()
+    find_package(JPEG REQUIRED)
+    find_package(LibXml2 2.9.7 REQUIRED)
+    find_package(PNG REQUIRED)
+    find_package(SQLite3 REQUIRED)
+    if (NOT TARGET SQLite3::SQLite3) # CMake < 4.3 (same compat alias as GTK/Win)
+        add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
+    endif ()
+    find_package(WebP REQUIRED COMPONENTS demux)
+    find_package(ZLIB REQUIRED)
+
+    # SSL tier — built into the sysroot by tools/build-deps/ssl-tier.sh:
+    # OpenSSL 3.5 (libcrypto for PAL's digests) + brotli + libpsl.
+    # The vendored Skia also REQUIREs Fontconfig on non-Win/non-PlayStation
+    # (ThirdParty/skia/CMakeLists.txt:6) — fontconfig rides in the same tier.
+    find_package(OpenSSL REQUIRED)
+    find_package(LibPSL 0.20.2 REQUIRED)
+    # Our static libpsl is built --enable-runtime=libicu (ssl-tier.sh) but
+    # libpsl.pc/FindLibPSL advertise only -lpsl; propagate the ICU dependency
+    # or the embedder link fails with undefined u_*/uidna_* symbols.
+    target_link_libraries(LibPSL::LibPSL INTERFACE ICU::uc)
+
+    # WebCore/CMakeLists.txt links OpenGL::GLES unconditionally on CMake ports
+    # (ANGLE / epoxy / system GLES elsewhere). Emscripten's GLES2+EGL are emcc
+    # link-time JS libraries with headers in the default sysroot include path —
+    # there is no .a for a find module, so satisfy generation with an empty
+    # INTERFACE target. CPU-raster Phase 2 never calls GL; the Skia GPU path
+    # (Phase 6) will wire -lGL/-sFULL_ES2 style flags at final link instead.
+    if (NOT TARGET OpenGL::GLES)
+        add_library(OpenGL::GLES INTERFACE IMPORTED)
+    endif ()
+endif ()
