{
  "name": "browsception",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "wt-setup": "node scripts/wt-setup.mjs",
    "pretest": "node scripts/wt-setup.mjs --quiet",
    "pretest:tier2": "node scripts/wt-setup.mjs --quiet",
    "test": "npm run test:tier0 && npm run test:tier1",
    "test:tier0": "node --test 'test/tier0/*.test.mjs'",
    "test:tier1": "node --test --test-concurrency=1 'test/tier1/*.test.mjs'",
    "test:tier2": "node --test --test-concurrency=1 'test/tier2/*.test.mjs'",
    "test:tier2:firefox": "node --test test/tier2/firefox.test.mjs",
    "release": "node scripts/release.mjs",
    "release:chrome": "node scripts/release.mjs chrome",
    "release:firefox": "node scripts/release.mjs firefox",
    "pack": "node scripts/pack-ext.mjs",
    "fixtures": "node test/fixtures/server.mjs"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "playwright-core": "^1.62.1"
  },
  "dependencies": {
    "binaryen": "130.0.0"
  }
}
