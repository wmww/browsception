+/*
+ * PORT=Emscripten scrollbar theme, cribbed from
+ * platform/playstation/ScrollbarThemePlayStation.cpp (class folded into the
+ * .cpp — no other TU needs the type). Flat-color composite scrollbars.
+ */
+
+#include "config.h"
+#include "ScrollbarThemeComposite.h"
+
+#include "GraphicsContext.h"
+#include "NotImplemented.h"
+#include "ScrollView.h"
+#include "Scrollbar.h"
+
+namespace WebCore {
+
+class ScrollbarThemeEmscripten final : public ScrollbarThemeComposite {
+public:
+    ScrollbarThemeEmscripten() = default;
+    virtual ~ScrollbarThemeEmscripten() = default;
+
+    int scrollbarThickness(ScrollbarWidth scrollbarWidth = ScrollbarWidth::Auto, OverlayScrollbarSizeRelevancy = OverlayScrollbarSizeRelevancy::IncludeOverlayScrollbarSize) override
+    {
+        if (scrollbarWidth == ScrollbarWidth::None)
+            return 0;
+        return 7;
+    }
+
+    bool hasButtons(Scrollbar&) override { return false; }
+    bool hasThumb(Scrollbar&) override { return true; }
+
+    IntRect backButtonRect(Scrollbar&, ScrollbarPart, bool = false) override { return { }; }
+    IntRect forwardButtonRect(Scrollbar&, ScrollbarPart, bool = false) override { return { }; }
+    IntRect trackRect(Scrollbar& scrollbar, bool = false) override { return scrollbar.frameRect(); }
+
+    void paintTrackBackground(GraphicsContext& context, Scrollbar& scrollbar, const IntRect& trackRect) override
+    {
+        context.fillRect(trackRect, scrollbar.enabled() ? Color::lightGray : SRGBA<uint8_t> { 224, 224, 224 });
+    }
+
+    void paintThumb(GraphicsContext& context, Scrollbar& scrollbar, const IntRect& thumbRect) override
+    {
+        if (scrollbar.enabled())
+            context.fillRect(thumbRect, Color::darkGray);
+    }
+};
+
+ScrollbarTheme& ScrollbarTheme::nativeTheme()
+{
+    static ScrollbarThemeEmscripten theme;
+    return theme;
+}
+
+} // namespace WebCore
