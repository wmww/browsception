{
 "manifest_version": 3,
 "name": "browsception",
 "version": "0.1.0",
 "description": "Runs websites inside a nested wasm browser engine.",
 "permissions": [
  "declarativeNetRequest",
  "webRequest",
  "storage",
  "tabs"
 ],
 "host_permissions": [
  "<all_urls>"
 ],
 "action": {
  "default_popup": "ext/popup.html",
  "default_title": "browsception"
 },
 "options_ui": {
  "page": "ext/options.html",
  "open_in_tab": true
 },
 "web_accessible_resources": [
  {
   "resources": [
    "ext/viewer.html"
   ],
   "matches": [
    "<all_urls>"
   ]
  }
 ],
 "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
 },
 "key": "",
 "minimum_chrome_version": "124",
 "background": {
  "service_worker": "ext/sw.mjs",
  "type": "module"
 },
 "declarative_net_request": {
  "rule_resources": [
   {
    "id": "catchall",
    "enabled": true,
    "path": "rules/catchall.json"
   }
  ]
 },
 "cross_origin_opener_policy": {
  "value": "same-origin"
 },
 "cross_origin_embedder_policy": {
  "value": "require-corp"
 }
}
