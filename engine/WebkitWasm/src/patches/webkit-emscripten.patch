+    // CONNECTING forever (connect() no-ops without a peer). Fail the
+    // constructor catchably; page-level WebSockets keep their existing
+    // clean-error behavior (the embedder's fail-fast channel). Real worker
+    // WebSockets come with Phase W-B threads, where the semaphore wait is
+    // legal.
+    if (is<WorkerGlobalScope>(context))
+        return Exception { ExceptionCode::NotSupportedError, "WebSocket inside workers is not supported in this single-threaded engine"_s };
+#endif
+
