node_modules/
# Staged into the extension root by tools/stage-engine.mjs: the engine
# artifact plus the three files its worker pre-js fetches from the host root
# (guest wasm shim, media stubs, binaryen).
src/engine/
src/vendor/
src/wasm-polyfill.js
src/media-stub.js
test/fixtures/ca/
dist/
*.log
*.pem
_metadata/

# Engine build state — shared singleton in the main checkout, never tracked.
# Sources under engine/WebkitWasm/{src,tools,web} ARE tracked.
engine/WebkitWasm/third_party/
engine/WebkitWasm/build/
engine/artifacts/
engine/cmake-3.31.7-linux-x86_64/
engine/logs/
engine/.build.lock
engine/.build.owner
engine/.webkit-patch.applied
engine/.webkit-patch.owner

# Ephemeral git worktrees (a checkout must never be committed into its parent).
.worktrees/

# Bench results are per-machine lab output, never committed. Root-anchored:
# a bare `bench/` would also swallow the suite's own source in tools/bench/.
/bench/
