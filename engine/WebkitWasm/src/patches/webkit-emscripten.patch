diff --git a/Source/WebCore/PlatformEmscripten.cmake b/Source/WebCore/PlatformEmscripten.cmake
new file mode 100644
index 00000000000..457e97ec653
--- /dev/null
+++ b/Source/WebCore/PlatformEmscripten.cmake
@@ -0,0 +1,136 @@
+# WebCore platform file for PORT=Emscripten.
+# Structure cribbed from PlatformPlayStation.cmake / PlatformWin.cmake:
+# ImageDecoders + Skia for graphics, the curl port's platform TYPES for
+# networking. No EGL/libwpe/TextureMapper — Phase 2 renders via Skia CPU
+# raster into a memory buffer that the embedder blits to the host <canvas>.
+#
+# NETWORKING: there is no transport in the engine. Every load goes out over
+# the embedder's host-fetch bridge (src/embedder/BibNetBridge.*), so libcurl,
+# libssl and nghttp2 are NOT linked and platform/Curl.cmake is deliberately
+# NOT included — we take only the subset below. USE_CURL stays ON because
+# ResourceRequest/ResourceResponse/ResourceError/CertificateInfo/
+# ProtectionSpace/AuthenticationChallenge *are* the port's platform types
+# under USE(CURL), as is the CookieJarDB cookie jar.
+include(platform/ImageDecoders.cmake)
+
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/platform/network/curl"
+)
+
+list(APPEND WebCore_SOURCES
+    # Cookie jar (sqlite, self-contained; feeds OPFS persistence).
+    platform/network/curl/CookieJarDB.cpp
+    platform/network/curl/CookieStorageCurl.cpp
+    platform/network/curl/CookieUtil.cpp
+    platform/network/curl/NetworkStorageSessionCurl.cpp
+    platform/network/curl/PublicSuffixStoreCurl.cpp     # libpsl: cookie-domain security
+
+    # Platform types for the loader (no libcurl symbols left in these).
+    platform/network/curl/CertificateInfoCurl.cpp
+    platform/network/curl/DNSResolveQueueCurl.cpp
+    platform/network/curl/ProtectionSpaceCurl.cpp
+    platform/network/curl/ResourceErrorCurl.cpp
+    platform/network/curl/ResourceRequestCurl.cpp
+    platform/network/curl/ResourceResponseCurl.cpp
+)
+
+list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+    platform/network/curl/AuthenticationChallenge.h
+    platform/network/curl/CertificateInfo.h
+    platform/network/curl/CookieJarDB.h
+    platform/network/curl/CookieUtil.h
+    platform/network/curl/DNSResolveQueueCurl.h
+    platform/network/curl/ProtectionSpaceCurl.h
+    platform/network/curl/ResourceError.h
+    platform/network/curl/ResourceRequest.h
+    platform/network/curl/ResourceResponse.h
+)
+
+list(APPEND WebCore_LIBRARIES
+    LibPSL::LibPSL
+)
+
+# brotli: a freetype dep (WOFF2 decoding), not a curl one — it stays.
+find_library(BROTLIDEC_LIBRARY brotlidec REQUIRED)
+find_library(BROTLICOMMON_LIBRARY brotlicommon REQUIRED)
+list(APPEND WebCore_LIBRARIES
+    ${BROTLIDEC_LIBRARY}
+    ${BROTLICOMMON_LIBRARY}
+)
+# platform/OpenSSL.cmake (the WebCrypto backend) is DEFERRED to Phase 4:
+# in 2.52 those sources are written against BoringSSL (<openssl/hkdf.h>
+# one-shot HKDF(), non-const EVP_PKEY_get0_EC_KEY, case-insensitive
+# "openssl/X509.h") and do not compile against real OpenSSL 3.5 on a
+# case-sensitive FS. First paint needs none of it. Re-adding requires either
+# ~4 file patches (EVP_KDF-based HKDF, x509.h, const casts) or a BoringSSL
+# swap for the whole TLS tier. Until then JSSubtleCrypto bindings may leave
+# undefined CryptoAlgorithm* symbols at EMBEDDER link time (not at archive
+# time) — resolve when wiring the embedder.
+
+if (USE_SKIA)
+    include(platform/Skia.cmake)
+    # GTK/WPE get fontconfig headers from the system include path; our cross
+    # sysroot is not a default include dir, so wire the imported target into
+    # WebCore explicitly — FontCacheSkia.cpp and SkiaSystemFallbackFontCache.cpp
+    # call fontconfig directly on the non-Android/non-Win path.
+    find_package(Fontconfig 2.13.0 REQUIRED)
+    list(APPEND WebCore_LIBRARIES Fontconfig::Fontconfig)
+endif ()
+
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    ${WEBCORE_DIR}/platform
+    ${WEBCORE_DIR}/platform/generic
+    ${WEBCORE_DIR}/platform/graphics/egl
+    ${WEBCORE_DIR}/platform/graphics/emscripten
+    ${WEBCORE_DIR}/platform/graphics/opengl
+    ${WEBCORE_DIR}/platform/mediacapabilities
+    ${WEBCORE_DIR}/platform/video-codecs
+)
+
+list(APPEND WebCore_SOURCES
+    accessibility/emscripten/AXObjectCacheEmscripten.cpp
+    accessibility/emscripten/AccessibilityObjectEmscripten.cpp
+
+    crypto/emscripten/CryptoStubsEmscripten.cpp
+
+    editing/emscripten/EditorEmscripten.cpp
+
+    platform/emscripten/MIMETypeRegistryEmscripten.cpp
+    platform/emscripten/PasteboardEmscripten.cpp
+    platform/emscripten/PlatformKeyboardEventEmscripten.cpp
+    platform/emscripten/PlatformScreenEmscripten.cpp
+    platform/emscripten/ScrollbarThemeEmscripten.cpp
+    platform/emscripten/ThemeEmscripten.cpp
+    platform/emscripten/UserAgentEmscripten.cpp
+
+    platform/network/emscripten/NetworkStateNotifierEmscripten.cpp
+
+    platform/generic/KeyedDecoderGeneric.cpp
+    platform/generic/KeyedEncoderGeneric.cpp
+
+    # No GPU path: upstream PlatformDisplay.cpp / egl/GLDisplay.cpp are
+    # deliberately NOT compiled — they call into Emscripten's EGL, which
+    # creates WebGL contexts and would put GL entry points in the module's
+    # imports (notes/security.md). GLStubsEmscripten.cpp resolves the few
+    # symbols the Skia paths reference.
+    platform/graphics/emscripten/GLStubsEmscripten.cpp
+    platform/graphics/emscripten/SystemFontDatabaseEmscripten.cpp
+
+    platform/text/Hyphenation.cpp
+    platform/text/LocaleICU.cpp
+
+    platform/unix/LoggingUnix.cpp
+    platform/unix/SharedMemoryUnix.cpp
+
+    rendering/emscripten/RenderThemeEmscripten.cpp
+)
+
+# Phase 2 embedder: the executable's sources and CMake logic live OUTSIDE the
+# WebKit tree (src/embedder/ in the project repo) so this patch stays minimal.
+# The include is DEFERRED to directory-end so it runs after
+# WEBKIT_FRAMEWORK(WebCore) — the WebCore target and the final
+# WebCore_*_INCLUDE_DIRECTORIES lists exist by then (same consumption pattern
+# as WebCoreTestSupport at the bottom of WebCore/CMakeLists.txt).
+if (EMSCRIPTEN_EMBEDDER_CMAKE)
+    cmake_language(DEFER CALL include "${EMSCRIPTEN_EMBEDDER_CMAKE}")
+endif ()
