--- a/Source/JavaScriptCore/runtime/JSCell.cpp
+++ b/Source/JavaScriptCore/runtime/JSCell.cpp
@@ -177,6 +177,35 @@ JSObject* JSCell::toObjectSlow(JSGlobalObject* globalObject) const
         return string->toObject(globalObject);
     if (const auto* bigInt = jsDynamicCast<const JSBigInt*>(this))
         return bigInt->toObject(globalObject);
+#if defined(__EMSCRIPTEN__)
+    // BIB (task #57): a for...in base INTERMITTENTLY reaches toObjectSlow
+    // with type() reading 0 (CellType) even though classInfo says it IS a
+    // JSObject — observed on authenticated discord.com (channel load); some
+    // loads dodge it, some hit it. The structure audit above passed (header
+    // intact) and classInfo-based casts don't consult the stale type byte,
+    // so jsDynamicCast<JSObject> still resolves it. toObject() of an object
+    // is the object itself, so RECOVER here instead of letting the
+    // secure-cast-to-Symbol abort the WHOLE engine over one bad enumeration.
+    // Only a cell that is genuinely neither object nor Symbol falls through
+    // to the original (aborting) path.
+    if (auto* object = jsDynamicCast<const JSObject*>(this)) {
+        // Log ONCE: if the flake is frequent (Discord's Flux/React enumerate
+        // constantly), a WTFLogAlways per recovery is a cross-thread console
+        // storm that would itself freeze the app. Recovery is silent after
+        // the first. (JSC is single-threaded — a plain static is safe.)
+        static bool loggedRecovery = false;
+        if (!loggedRecovery) {
+            loggedRecovery = true;
+            WTFLogAlways("BIB: toObjectSlow recovered object cell (JSType=%u classInfo=%s) — silenced after first", static_cast<unsigned>(type()), classInfo()->className.characters());
+        }
+        return const_cast<JSObject*>(object);
+    }
+    static bool loggedUnexpected = false;
+    if (!loggedUnexpected && !jsDynamicCast<const Symbol*>(this)) {
+        loggedUnexpected = true;
+        WTFLogAlways("BIB: toObjectSlow on unexpected non-object cell: JSType=%u classInfo=%s", static_cast<unsigned>(type()), classInfo()->className.characters());
+    }
+#endif
     return jsSecureCast<const Symbol*>(this)->toObject(globalObject);
 }
 
