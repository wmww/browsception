diff --git a/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp b/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp
index 1c8e16fe230..479997e2ffb 100644
--- a/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp
+++ b/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp
@@ -114,10 +114,43 @@ void ImageFrameWorkQueue::dispatch(const Request& request)
 {
     ASSERT(isMainThread());
 
+#if defined(__EMSCRIPTEN__)
+    // PORT=Emscripten is single-threaded: SynchronizedFixedQueue's blocking
+    // enqueue (BufferSize=8 — a page with >8 pending image decodes hits it;
+    // Wikipedia spun the only thread at 100% CPU forever) and the worker's
+    // blocking dequeue can never be satisfied by another thread. Skip the
+    // queue + worker loop entirely: defer the decode one RunLoop cycle via
+    // callOnMainThread, then deliver with upstream's staleness checks
+    // (stop() clears decodeQueue, which voids in-flight requests). The
+    // decode is synchronous on the only thread — jank is inherent here.
+    // m_workQueue stays null, so isDecodingWorkQueueIdle() remains true.
+    // Decoder check BEFORE the append: a request appended with no decoder
+    // has no delivery callback, and a stale head entry blocks every later
+    // first()==request delivery for this source (Codex 2026-06-10).
+    RefPtr decoder = protectedSource()->decoder();
+    if (!decoder)
+        return;
+
+    decodeQueue().append(request);
+
+    callOnMainThread([protectedThis = Ref { *this }, protectedSource = this->protectedSource(), protectedDecoder = decoder.releaseNonNull(), request] () mutable {
+        if (protectedSource.ptr() != protectedThis->m_source.get())
+            return;
+        if (protectedThis->decodeQueue().isEmpty() || protectedThis->decodeQueue().first() != request)
+            return;
+
+        PlatformImagePtr platformImage = protectedDecoder->createFrameImageAtIndex(request.index, request.subsamplingLevel, request.options);
+        RefPtr nativeImage = NativeImage::create(WTF::move(platformImage));
+
+        protectedThis->decodeQueue().removeFirst();
+        protectedSource->imageFrameDecodeAtIndexHasFinished(request.index, request.subsamplingLevel, request.animatingState, request.options, WTF::move(nativeImage));
+    });
+#else
     requestQueue().enqueue(request);
     decodeQueue().append(request);
 
     start();
+#endif
 }
 
 void ImageFrameWorkQueue::stop()
